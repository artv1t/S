# Environment
NODE_ENV=development
LOG_LEVEL=info

# RPC Configuration (10+ endpoints for high availability)
RPC_ENDPOINT_1=https://api.mainnet-beta.solana.com
RPC_ENDPOINT_2=https://solana-api.projectserum.com
RPC_ENDPOINT_3=https://rpc.ankr.com/solana
RPC_ENDPOINT_4=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
RPC_ENDPOINT_5=https://rpc.hellomoon.io/YOUR_API_KEY
RPC_ENDPOINT_6=https://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY
RPC_ENDPOINT_7=https://api.mainnet-beta.solana.com
RPC_ENDPOINT_8=https://solana-api.projectserum.com
RPC_ENDPOINT_9=https://rpc.ankr.com/solana
RPC_ENDPOINT_10=https://api.mainnet-beta.solana.com
RPC_TIMEOUT=3000
RPC_RATE_LIMIT=500
RPC_BATCH_SIZE=50
RPC_KEEP_ALIVE=true

# Performance Settings
MAX_CONCURRENT_TRADES=25
MAX_CONCURRENT_FILTERS=50
MAX_POSITIONS=100
WORKER_THREADS=4
MEMORY_LIMIT=2048
CPU_LIMIT=80

# Rate Limiting
JUPITER_RATE_LIMIT=50
DEXSCREENER_RATE_LIMIT=100
API_RATE_LIMIT=1000

# Caching
CACHE_TTL_METADATA=300
CACHE_TTL_POOL=60
CACHE_TTL_PRICE=30
REDIS_URL=redis://localhost:6379

# Trading Configuration
QUOTE_AMOUNT=0.0001
SLIPPAGE_LIMIT=15
MAX_SLIPPAGE=50
TAKE_PROFIT=50
STOP_LOSS=30
TTL_MINUTES=30

# Filters
ENABLE_ROUTE_GATE=true
ENABLE_ON_CHAIN=true
ENABLE_DEXSCREENER=true
RISK_THRESHOLD=70
FILTER_TIMEOUT=5000

# Paper Mode
PAPER_MODE=true
TEST_MODE=true
DRY_RUN=false

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=5000
PERFORMANCE_LOG_INTERVAL=10000

# Wallet Configuration
WALLET_PRIVATE_KEY_PATH=./wallets/wallet.json
WALLET_PASSPHRASE=your_passphrase_here

# API Configuration
API_PORT=3001
API_HOST=localhost
ENABLE_API=true
CORS_ORIGIN=*

# Database
DB_PATH=./data/bot.db
DB_BACKUP_INTERVAL=3600000

# Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
DISCORD_WEBHOOK_URL=your_discord_webhook_url
ENABLE_NOTIFICATIONS=true

# Security
CIRCUIT_BREAKER_MAX_FAILURES=10
DAILY_LOSS_LIMIT=0.05
MAX_EXPOSURE=0.2
RESERVE_SOL=0.01

# Filter specific settings
MAX_PRICE_IMPACT=15
MIN_POOL_SIZE=1
MAX_POOL_SIZE=100
MAX_TOP1_HOLDER_PERCENT=20
MAX_TOP5_HOLDER_PERCENT=50

# Advanced Filter Settings
POOL_MAX_AGE_MS=3600000
CONSECUTIVE_FILTER_MATCHES=3
FILTER_CHECK_DURATION=300000
FILTER_CHECK_INTERVAL=30000

# LP Protection Settings
LP_LOCK_DEADLINE_MS=900000
LP_BURN_THRESHOLD=80
LP_LOCKER_WHITELIST=TeamFinance,Unicrypt,PinkSale

# Program IDs
PUMP_FUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
RAYDIUM_CLMM_PROGRAM_ID=CAMMCzo5YL8w4VFF8KVHrK22GGUsp5VTaW7grrKgrWqK
RAYDIUM_AMM_PROGRAM_ID=675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8
METEORA_PROGRAM_ID=Eo7WjKq67rjJQS5xOyfPxS5C67L3Kp3C5HZ8N8o8N8o8
