{
  "name": "solana-sniper-bot",
  "version": "1.0.0",
  "description": "High-performance Solana sniper bot with 1000+ events/sec processing",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:paper": "PAPER_MODE=true node dist/index.js",
    "start:live": "PAPER_MODE=false node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:paper": "PAPER_MODE=true tsx watch src/index.ts",
    "dev:live": "PAPER_MODE=false tsx watch src/index.ts",
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "setup": "./scripts/setup.sh",
    "deploy": "./scripts/deploy.sh",
    "health-check": "./scripts/health-check.sh",
    "docker:build": "docker build -t solana-sniper-bot .",
    "docker:run": "docker run -d --name sniper-bot solana-sniper-bot",
    "load-test": "tsx scripts/loadTest.ts"
  },
  "dependencies": {
    "@solana/spl-token": "^0.3.9",
    "@solana/web3.js": "^1.87.6",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "axios": "^1.6.2",
    "better-sqlite3": "^9.2.2",
    "bn.js": "^5.2.1",
    "bs58": "^5.0.0",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "lucide-react": "^0.294.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.4",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "solana",
    "sniper",
    "bot",
    "trading",
    "defi",
    "typescript",
    "high-performance"
  ],
  "author": "Solana Sniper Bot",
  "license": "MIT"
}
