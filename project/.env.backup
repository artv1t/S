# Environment
NODE_ENV=development
LOG_LEVEL=info

# RPC Configuration - At least 3 endpoints required
RPC_ENDPOINT_1=https://api.mainnet-beta.solana.com
RPC_ENDPOINT_2=https://solana-api.projectserum.com
RPC_ENDPOINT_3=https://rpc.ankr.com/solana
RPC_ENDPOINT_4=https://solana-mainnet.g.alchemy.com/v2/demo
RPC_ENDPOINT_5=https://api.mainnet-beta.solana.com

# RPC Settings
RPC_TIMEOUT=3000
RPC_RATE_LIMIT=500
RPC_BATCH_SIZE=50
RPC_KEEP_ALIVE=true

# Performance Settings
MAX_CONCURRENT_TRADES=25
MAX_CONCURRENT_FILTERS=50
MAX_QUEUE_SIZE=1000
BATCH_SIZE=100
PROCESSING_INTERVAL=10

# Trading Configuration
QUOTE_AMOUNT=0.01
SLIPPAGE_TOLERANCE=5
MAX_SLIPPAGE=10
MIN_LIQUIDITY=1
MAX_LIQUIDITY=1000000
TAKE_PROFIT_PERCENT=50
STOP_LOSS_PERCENT=20
TTL_MINUTES=30

# Paper Trading
PAPER_MODE=true
PAPER_INITIAL_BALANCE=10

# Database
DB_PATH=./data/bot.db

# API Configuration
API_PORT=3001
API_HOST=localhost
API_KEY=your-secret-api-key-here
CORS_ORIGIN=http://localhost:3000

# WebSocket
WS_PORT=3001
WS_PATH=/socket.io

# Monitoring
ENABLE_METRICS=true
METRICS_INTERVAL=5000
HEALTH_CHECK_INTERVAL=10000

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ENABLE_NOTIFICATIONS=false

# Security
CIRCUIT_BREAKER_MAX_FAILURES=10
DAILY_LOSS_LIMIT=0.05
MAX_EXPOSURE=0.2
RESERVE_SOL=0.01

# Filter Settings
MAX_PRICE_IMPACT=15
MIN_POOL_SIZE=1
MAX_POOL_SIZE=100
MAX_TOP1_HOLDER_PERCENT=20
MAX_TOP5_HOLDER_PERCENT=50

# Program IDs
PUMP_FUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
RAYDIUM_PROGRAM_ID=675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8
METEORA_PROGRAM_ID=Eo7WjKq67rjJQSZxS6z3YkapzY3eMj6Xy8X5EQVn5UaB
JUPITER_PROGRAM_ID=JUP6LkbZbjS1jKKwapdHNy74zcZ3tLUZoi5QNyVTaV4

# Wallet Configuration
WALLET_PATH=./wallets
WALLET_PASSWORD=your-wallet-password-here
ENCRYPTION_KEY=your-encryption-key-here
ENABLE_API=true

# Filter Settings
ENABLE_ROUTE_GATE=true
ENABLE_ON_CHAIN=true
ENABLE_DEXSCREENER=true
